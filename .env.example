# Server Configuration
PORT=8080
NODE_ENV=development

# Platform Integration
PLATFORM_URL=https://agentbase.me
PLATFORM_SERVICE_TOKEN=your-service-token-here

# CORS Configuration
CORS_ORIGIN=https://agentbase.me

# Authentication (JWT Provider)
JWT_SECRET=your-jwt-secret-here-min-32-characters
JWT_ISSUER=agentbase.me
JWT_AUDIENCE=mcp-server

# YouTube Data API v3
# Credentials are fetched per-user via tokenResolver from the platform
