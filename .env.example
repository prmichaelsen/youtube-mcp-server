# Server Configuration
PORT=8080
NODE_ENV=development

# Platform Integration
# PLATFORM_SERVICE_TOKEN is the shared secret between agentbase.me and this server.
# agentbase.me signs JWTs with it, this server verifies JWTs with it.
# Get this from your MCP server registration in agentbase.me.
PLATFORM_URL=https://agentbase.me
PLATFORM_SERVICE_TOKEN=your-service-token-here

# CORS Configuration
CORS_ORIGIN=https://agentbase.me

# YouTube Data API v3
# Per-user YouTube OAuth credentials are fetched via tokenResolver from agentbase.me
