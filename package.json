{
  "name": "youtube-mcp",
  "version": "1.0.0",
  "description": "MCP server wrapping the YouTube Data API v3 for AI agents, mcp-auth enabled",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node esbuild.build.js",
    "watch": "node esbuild.watch.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prmichaelsen/mcp-auth": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  }
}
